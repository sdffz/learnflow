# The default demo runs without any model credentials.
# Set all three model values to enable the OpenAI-compatible live adapter.
LEARNFLOW_MODEL_API_KEY=
LEARNFLOW_MODEL_BASE_URL=https://your-openai-compatible-endpoint.example/v1
LEARNFLOW_MODEL_NAME=your-model-name
LEARNFLOW_DATA_DIR=/var/lib/learnflow

# Learning-platform connector. Disabled unless an operator explicitly enables it.
LEARNFLOW_CHAOXING_ENABLED=false
# Generate with: openssl rand -base64 32
# LEARNFLOW_CONNECTOR_KEY=

# Comma-separated extra browser origins allowed for mutating requests.
# same-origin and local development origins are accepted automatically.
# LEARNFLOW_ALLOWED_ORIGINS=https://learn.example.com

# Optional local ports used by scripts/dev.sh.
LEARNFLOW_API_PORT=8000
LEARNFLOW_WEB_PORT=5173
