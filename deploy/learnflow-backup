#!/usr/bin/env bash
set -euo pipefail

database_path="/var/lib/learnflow/learnflow.sqlite3"
backup_dir="/var/backups/learnflow"
retention_days="${LEARNFLOW_BACKUP_RETENTION_DAYS:-14}"

install -d -m 750 "$backup_dir"
exec 9>"$backup_dir/.backup.lock"
flock -n 9

umask 077
temporary="$(mktemp "$backup_dir/.learnflow.XXXXXX.sqlite3")"
archive="$backup_dir/learnflow-$(date -u +%Y%m%dT%H%M%SZ).sqlite3.gz"

cleanup() {
  rm -f "$temporary" "$archive.tmp"
}
trap cleanup EXIT

sqlite3 "$database_path" ".timeout 5000" ".backup '$temporary'"
integrity="$(sqlite3 "$temporary" "PRAGMA integrity_check;")"
if [[ "$integrity" != "ok" ]]; then
  echo "backup integrity check failed: $integrity" >&2
  exit 1
fi

gzip -c "$temporary" > "$archive.tmp"
mv "$archive.tmp" "$archive"
find "$backup_dir" -maxdepth 1 -type f \
  -name 'learnflow-*.sqlite3.gz' \
  -mtime "+$retention_days" \
  -delete

echo "backup created: $archive"
