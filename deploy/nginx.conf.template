limit_req_zone $binary_remote_addr zone=learnflow_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=learnflow_auth:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=learnflow_conn:10m;

server {
    listen 80;
    server_name __SERVER_NAME__ localhost 127.0.0.1;
    server_tokens off;

    root /opt/learnflow/current/frontend/dist;
    index index.html;
    client_max_body_size 30m;
    limit_req_status 429;
    limit_conn_status 429;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'self' data: blob:; connect-src 'self'; font-src 'self' data:" always;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    location = /healthz {
        access_log off;
        proxy_pass http://127.0.0.1:8000/api/health/ready;
        include /opt/learnflow/current/deploy/nginx-proxy.conf;
    }

    location = /api/auth/login {
        limit_req zone=learnflow_auth burst=5 nodelay;
        limit_conn learnflow_conn 10;
        proxy_pass http://127.0.0.1:8000;
        include /opt/learnflow/current/deploy/nginx-proxy.conf;
    }

    location = /api/auth/register {
        limit_req zone=learnflow_auth burst=3 nodelay;
        limit_conn learnflow_conn 10;
        proxy_pass http://127.0.0.1:8000;
        include /opt/learnflow/current/deploy/nginx-proxy.conf;
    }

    location = /api/learning/imports/zip/previews {
        client_max_body_size 260m;
        limit_req zone=learnflow_api burst=5 nodelay;
        limit_conn learnflow_conn 3;
        proxy_pass http://127.0.0.1:8000;
        include /opt/learnflow/current/deploy/nginx-proxy.conf;
    }

    location /api/ {
        limit_req zone=learnflow_api burst=40 nodelay;
        limit_conn learnflow_conn 30;
        proxy_pass http://127.0.0.1:8000;
        include /opt/learnflow/current/deploy/nginx-proxy.conf;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
