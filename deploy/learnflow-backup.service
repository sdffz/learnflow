[Unit]
Description=LearnFlow SQLite backup
After=learnflow.service

[Service]
Type=oneshot
User=learnflow
Group=learnflow
ExecStart=/usr/local/sbin/learnflow-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/learnflow
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
